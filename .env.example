# Server Configuration
PORT=3001
NODE_ENV=development
ALLOWED_ORIGIN=http://localhost:5173

# Amazon Bedrock LLM Configuration
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-3-5-sonnet-20241022-v2:0
# Set AWS credentials if running locally without AWS CLI setup
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key

# Mock LLM Flag (Set to true ONLY for local testing/vitest without active AWS Bedrock credentials)
MOCK_LLM=false

# Database Configuration (Optional: falls back to in-memory store if omitted)
MONGODB_URI=mongodb://localhost:27017/interviewdojo
